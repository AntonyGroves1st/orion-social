# Copy to .env. Never put these values in web/.env.

PORT=8791
PUBLIC_ORIGIN=http://localhost:5732
JWT_SECRET=generate_with_python_secrets_token_hex_32

SUPABASE_URL=https://YOUR_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# 1 Orion coin = this many cents. Default: 100 cents ($1.00).
ORION_COIN_CENTS=100

# When the live room creator has profiles.stripe_account_id, this creates a
# Stripe Connect destination charge and keeps the 15% network share as the
# application fee. Set false to ledger only / manual payout.
STRIPE_CONNECT_DESTINATION_CHARGES=true
