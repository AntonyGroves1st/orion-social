{
  "name": "orion-social-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5732",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:capacitor": "tsc --noEmit && cross-env CAPACITOR=1 vite build",
    "cap:sync": "npx cap sync android",
    "cap:sync:ios": "npx cap sync ios",
    "cap:sync:all": "npx cap sync android && npx cap sync ios",
    "cap:open": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "preview": "vite preview --port 5732"
  },
  "dependencies": {
    "@capacitor/android": "^7.2.0",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.2.0",
    "@capacitor/ios": "^7.2.0",
    "@stripe/react-stripe-js": "^6.3.0",
    "@stripe/stripe-js": "^9.5.0",
    "@supabase/supabase-js": "^2.49.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "7.6.2",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.2.0",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "typescript": "~5.7.3",
    "vite": "^6.4.3"
  }
}
