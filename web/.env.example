# Copy to web/.env — never commit real keys (repo gitignores web/.env).
#
# Dashboard → Settings → API → Project URL (host only). Do NOT paste the REST URL ending in /rest/v1 —
# the client adds /rest/v1 itself; including it breaks requests (“Invalid path specified in request URL”).
VITE_SUPABASE_URL=https://YOUR_REF.supabase.co
# Legacy anon JWT (eyJ…) OR new publishable key (sb_publishable_…):
VITE_SUPABASE_ANON_KEY=

# Stripe Checkout gateway. Use /payments locally through Vite proxy, or your hosted payments service URL.
VITE_ORION_PAYMENTS_URL=/payments

# Shareable invite links for live rooms (REQUIRED for phone/APK — NOT 127.0.0.1).
# Set to wherever you host the web app, e.g. https://orion.yoursite.com
# LAN test (same WiFi): http://192.168.1.50:5173 with `npm run dev -- --host`
# VITE_PUBLIC_APP_URL=https://your-public-web-url.com

# Optional TURN relay for mobile/carrier NAT (improves 8-way mesh when STUN alone fails).
# VITE_TURN_URL=turn:your-turn-server:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
